# Dependencies, installed by scripts/launch.sh on first run
node_modules/

# Nothing writable belongs in the plugin: installs are versioned, so an upgrade
# is a new directory. Indexes, cache and profile live in ~/.legal-kit and
# ~/.claude/plugins/config/legal-kit instead. These two are here only because
# this working copy was also the old template.
.data/
.cache/
PROFILE.md
CLAUDE.md

.DS_Store
*.log
*.bak
*.bak-*
